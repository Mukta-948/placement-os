# Server
PORT=3000
LOG_LEVEL=info

# Caspian: required to receive and reply to messages.
CASPIAN_API_KEY=replace_with_your_caspian_api_key
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_EMAIL_USERNAME=placement-coach
# Set to false to disable a channel without changing code.
CASPIAN_ENABLE_EMAIL=true
CASPIAN_ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible LLM endpoint.
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000

# Local durable conversation memory. Mount this location in production.
MEMORY_FILE=data/conversations.json
MAX_CONVERSATION_TURNS=12
